{
  "name": "@chagas42/prs",
  "version": "0.2.3",
  "description": "GitHub PR review leaderboard for your team",
  "author": "chagas42",
  "bin": {
    "pr-score": "./dist/index.js",
    "prs": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "tsup",
    "start": "bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "lint": "biome lint src",
    "lint:fix": "biome lint --write src",
    "format": "biome format --write src",
    "format:check": "biome format src",
    "check:all": "tsc --noEmit && biome check src && pnpm build"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.0.0",
    "@octokit/graphql": "^7.0.0",
    "@octokit/rest": "^20.0.0",
    "cli-table3": "^0.6.0",
    "commander": "^12.0.0",
    "picocolors": "^1.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.11",
    "@types/node": "^25.6.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/chagas42/gh-prs.git"
  },
  "keywords": [
    "github",
    "pr",
    "pull-request",
    "leaderboard",
    "cli",
    "team"
  ],
  "engines": {
    "node": ">=18.0.0"
  }
}
